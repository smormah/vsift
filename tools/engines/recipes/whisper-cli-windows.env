# whisper.cpp's command line for Windows x64, built by VSift (ADR 0032 decision D2):
# upstream's b5454 build imports the Microsoft C runtime and OpenMP
# (msvcp140, vcruntime140, vcruntime140_1, vcomp140; hosted inventory run
# 39604340709), which a clean Windows need not have. Sourced by engines.yml.
ENGINE=whisper-cli-windows
ENGINE_VERSION=1.9.5-r1
TARGET=windows-x64
UPSTREAM_REPOSITORY=https://github.com/ggml-org/whisper.cpp
UPSTREAM_TAG=v1.9.5
UPSTREAM_COMMIT=d1be6fde11ac6e0407606b4e42fe72d34add8037
LICENCE=MIT
