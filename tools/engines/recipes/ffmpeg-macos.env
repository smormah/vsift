# An LGPL static FFmpeg and FFprobe for macOS arm64, built by VSift (ADR 0032
# decision D1, the maintainer's decision of 2026-10-21): no publisher offers a
# suitable one. The commit is the one the Linux and Windows pins are built from
# (BtbN autobuild-2026-08-31-13-27, n9.0.1-11-ge47273f4d9). Sourced by engines.yml.
ENGINE=ffmpeg-macos
ENGINE_VERSION=9.0.1.11-r1
TARGETS=macos-arm64
UPSTREAM_REPOSITORY=https://github.com/FFmpeg/FFmpeg
UPSTREAM_TAG=
UPSTREAM_COMMIT=e47273f4d9227152dcbf543cebaf9e2430ddbcc4
# What `ffmpeg -version` names: the git description the other pins carry.
UPSTREAM_DESCRIBE=n9.0.1-11-ge47273f4d9
LICENCE=LGPL-2.1-or-later
