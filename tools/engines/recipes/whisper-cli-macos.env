# whisper.cpp's command line for macOS arm64, built by VSift (ADR 0032 decision D):
# upstream publishes no macOS command-line build. Sourced by engines.yml.
ENGINE=whisper-cli-macos
# The upstream version, then VSift's recipe revision.
ENGINE_VERSION=1.9.5-r1
TARGET=macos-arm64
UPSTREAM_REPOSITORY=https://github.com/ggml-org/whisper.cpp
UPSTREAM_TAG=v1.9.5
UPSTREAM_COMMIT=d1be6fde11ac6e0407606b4e42fe72d34add8037
LICENCE=MIT
