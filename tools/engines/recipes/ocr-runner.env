# The OCR runner (ADR 0030, ADR 0032 decision D): VSift's own crate
# crates/vsift-ocr-runner, built from the tagged commit of this repository, with
# Microsoft's ONNX Runtime 1.31.0 library and the two PP-OCRv5 models beside it,
# each fetched by its pinned size and SHA-256 (tools/p16_ocr_runner.py stage) and
# republished unchanged under their licences. Sourced by engines.yml.
ENGINE=ocr-runner
# The crate's version, then VSift's recipe revision.
ENGINE_VERSION=0.1.0-r1
TARGETS="linux-x64 windows-x64 macos-arm64"
# No upstream repository: the source is this repository at the tagged commit.
UPSTREAM_REPOSITORY=
UPSTREAM_TAG=
UPSTREAM_COMMIT=
CRATE=vsift-ocr-runner
LICENCE="MIT OR Apache-2.0 (runner); MIT (ONNX Runtime); Apache-2.0 (models)"
