{
  "$comment": "Project permission rules of the value measurement: the same file for all four arms (R0, R1, V0, V1).",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(vsift:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(whisper-cli:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(uniq:*)",
      "Bash(mkdir:*)",
      "Bash(jq:*)",
      "Bash(sed:*)",
      "Bash(find:*)",
      "Read(./**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(sort -o*)",
      "Bash(sort * -o*)",
      "Bash(sort *--output*)",
      "Bash(sed -i*)",
      "Bash(sed * -i*)",
      "Bash(sed *--in-place*)",
      "Bash(find *-delete*)",
      "Bash(find *-exec*)",
      "Bash(find *-ok*)",
      "Bash(find *-fprint*)",
      "Bash(find *-fls*)",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent"
    ]
  },
  "disableAllHooks": true,
  "disableBundledSkills": true,
  "enableAllProjectMcpServers": false,
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 1
}
