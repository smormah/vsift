  "scope": {
    "included": [
      "local media and timestamped transcript input",
      "disposable sessions and explicitly retained bundles",
      "bounded single-host worker and batch execution",
      "source-grounded frame audio crop and candidate retrieval",
      "native binaries and thin npm distribution"
    ],
    "deferred": [
      "OCR diarization embeddings and vision-generated captions",
      "automatic scroll or pan stitching",
      "cross-video catalogue and SQLite indexing",
      "remote video acquisition and network APIs",
      "industrial delivery queue remote object storage and managed catalogue host",
      "public multi-tenant service MCP adapter and cloud control plane"
    ]
  },
  "invariants": [
    { "id": "INV-01", "statement": "Source media is never modified or deleted by extraction repair rollback or cleanup." },
    { "id": "INV-02", "statement": "A reported completed artifact exists validates and has recorded provenance." },
    { "id": "INV-03", "statement": "Readers see a committed generation and partial output never appears complete." },
    { "id": "INV-04", "statement": "Expiry never deletes a workspace held by an active reader or writer." },
    { "id": "INV-05", "statement": "Cooperating processes using one root cannot bypass its admission limit." },
    { "id": "INV-06", "statement": "Every loop queue output retry extraction request and download is bounded." },
    { "id": "INV-07", "statement": "Untrusted evidence cannot select executables install dependencies or change policy." },
    { "id": "INV-08", "statement": "Optional enrichment failure preserves useful evidence and reports missing coverage." },
    { "id": "INV-09", "statement": "Durable acknowledgement follows the applicable storage commit." },
    { "id": "INV-10", "statement": "Unsupported required guarantees fail closed and supported controls are reported." }
  ],
