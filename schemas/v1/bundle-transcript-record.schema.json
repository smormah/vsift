{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsift.dev/schemas/v1/bundle-transcript-record.schema.json",
  "title": "VSift retained bundle transcript record v1",
  "description": "The content of a retained bundle artifact whose bundle.json kind is transcript_record: one immutable transcript revision with all of its segments, stored as compact UTF-8 JSON and named artifact-<sha256>.json. This is a storage record, not an operation response: schema_version is the integer 1 and format names the record. Times are integer microseconds on the normalized source timeline; each segment range is its cue timing plus offset_us. text is the stored cue text with recognised markup removed (lines joined with \\n; no other control character); original_text is the payload as written and is present only when it differs from text. Text is untrusted input: sanitize it before display. bundle validate decodes every transcript record strictly (unknown fields, values and newer versions are rejected) and re-checks it against the import rules; this schema describes its shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "revision_id",
    "revision",
    "source_id",
    "source_segment",
    "origin",
    "offset_us",
    "sidecar",
    "language",
    "warnings",
    "segments"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "format": { "const": "vsift.transcript_record" },
    "revision_id": { "type": "string", "pattern": "^trv_[a-z0-9]{16,64}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "source_id": { "type": "string", "pattern": "^src_sha256_[0-9a-f]{64}$" },
    "source_segment": {
      "description": "The one closed source segment of a finite file: index 0 from time 0 to the probed duration.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "start_us", "end_us", "state"],
      "properties": {
        "id": { "type": "string", "pattern": "^sgm_[a-z0-9]{16,64}$" },
        "index": { "const": 0 },
        "start_us": { "const": 0 },
        "end_us": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["closed"] }
      }
    },
    "origin": { "enum": ["imported_srt", "imported_webvtt"] },
    "offset_us": {
      "type": "integer",
      "minimum": -86400000000,
      "maximum": 86400000000
    },
    "sidecar": {
      "description": "Identity of the exact supplied bytes that were parsed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    },
    "language": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,34}$" }
      ]
    },
    "warnings": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "count", "first_cue"],
        "properties": {
          "kind": {
            "enum": [
              "empty_cues_skipped",
              "markup_removed",
              "speaker_label_discarded",
              "overlapping_cues",
              "cues_outside_source",
              "cues_crossing_source_boundary"
            ]
          },
          "count": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "first_cue": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
        }
      }
    },
    "segments": {
      "description": "Every segment of the revision in ordinal order.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ordinal",
          "start_us",
          "end_us",
          "text",
          "original_text",
          "speaker",
          "cue_ordinal",
          "cue_line",
          "cue_start_us",
          "cue_end_us"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^tsg_[a-z0-9]{16,64}$" },
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 20000 },
          "start_us": { "type": "integer", "minimum": 0 },
          "end_us": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "original_text": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1, "maxLength": 4096 }
            ]
          },
          "speaker": {
            "description": "A WebVTT voice label (imported_webvtt only), never a verified identity.",
            "oneOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1, "maxLength": 128 }
            ]
          },
          "cue_ordinal": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "cue_line": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "cue_start_us": { "type": "integer", "minimum": 0 },
          "cue_end_us": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
