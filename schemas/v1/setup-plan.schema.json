{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsift.dev/schemas/v1/setup-plan.schema.json",
  "title": "VSift reviewed setup plan v1",
  "description": "A read-only setup plan. Its intent (profile, target, managed_install, catalogue, plan_digest, every action's reviewed artifact, each dependency's and the model's disposition and next step) is what plan_digest binds and what setup install compares with a saved plan. Its observed state (readiness, install_needed, each dependency's and the model's status, each action's state) is what commands would use now, managed versions included (P13 PR 4): it changes as setup install applies the plan and is not compared, so a rerun of the same accepted setup install continues. An action whose state is current is installed at the plan's version; install_needed is false when every action is current or there is none.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "operation_id", "status", "data", "warnings", "error", "coverage", "lifecycle"],
  "properties": {
    "schema_version": { "const": "1" },
    "command": { "const": "setup.plan" },
    "operation_id": { "type": "null" },
    "status": { "const": "complete" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "readiness", "verification_scope", "target", "local_asr_model", "managed_install", "catalogue_revision", "stop_new_plans_at", "plan_digest", "install_needed", "actions", "dependencies"],
      "properties": {
        "profile": { "enum": ["desktop", "worker"] },
        "readiness": { "enum": ["ready", "degraded", "blocked"] },
        "verification_scope": { "const": "executable_probe_and_reviewed_catalogue" },
        "target": { "enum": ["ubuntu_24_04_x86_64", "windows_x86_64", "macos_arm64", "unsupported"] },
        "local_asr_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "disposition", "required_authority", "next_step"],
          "properties": {
            "status": { "enum": ["missing", "configured_present_unverified", "managed_current"] },
            "disposition": { "enum": ["configured_model_probe_only", "managed_install", "manual_selection_required"] },
            "required_authority": { "enum": ["user", null] },
            "next_step": { "$ref": "#/$defs/step" }
          }
        },
        "managed_install": { "enum": ["catalogue_accepted", "not_required", "unavailable_target", "unavailable_catalogue_expired", "unavailable_catalogue_invalid"] },
        "catalogue_revision": { "type": ["string", "null"], "maxLength": 128 },
        "stop_new_plans_at": { "type": ["string", "null"], "maxLength": 32 },
        "plan_digest": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
        "install_needed": { "type": "boolean" },
        "actions": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/action" } },
        "optional_components": {
          "description": "Added in 0.3.0 (#409), absent from earlier plans: each optional component the plan includes, offers or cannot offer here. A desktop plan lists every optional component; a worker plan only an included one. status included: its actions (the JavaScript runtime, then yt-dlp) are part of this plan and its digest and are installed after the core; a failure of theirs never fails the core. not_included: offered and left out; add_command is the vsift command that makes the plan with it. unavailable: no managed version on this host. summary is one plain sentence to relay to the operator; download_bytes is null when unavailable.",
          "type": "array", "maxItems": 4,
          "items": { "$ref": "#/$defs/optional" }
        },
        "operator_decision_required": {
          "description": "Added in 0.3.0 (#409): when the plan offers or includes an optional component, the instruction to whoever runs setup to tell the operator about it and ask before accepting the plan; null otherwise.",
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 1024 }]
        },
        "dependencies": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["dependency", "status", "disposition", "required_authority", "next_step"],
            "properties": {
              "dependency": { "enum": ["ffmpeg", "ffprobe", "whisper"] },
              "status": { "enum": ["available", "missing", "unhealthy", "timed_out"] },
              "disposition": { "enum": ["existing_executable_probe_only", "managed_install", "manual_selection_required"] },
              "required_authority": { "enum": ["user", null] },
              "next_step": { "$ref": "#/$defs/step" }
            }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "managed_install": { "enum": ["catalogue_accepted", "not_required"] } } }, "then": { "properties": { "plan_digest": { "type": "string" }, "catalogue_revision": { "type": "string" }, "stop_new_plans_at": { "type": "string" } } } },
        { "if": { "properties": { "managed_install": { "enum": ["unavailable_target", "unavailable_catalogue_expired", "unavailable_catalogue_invalid"] } } }, "then": { "properties": { "plan_digest": { "type": "null" }, "actions": { "maxItems": 0 }, "install_needed": { "const": false } } } }
      ]
    },
    "warnings": { "const": [] },
    "error": { "type": "null" },
    "coverage": { "type": "null" },
    "lifecycle": { "type": "null" }
  },
  "$defs": {
    "optional": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "status", "installs", "summary", "purpose", "download_bytes", "licences", "terms_notice", "add_command", "actions", "next_step"],
      "properties": {
        "component": { "enum": ["yt_dlp"] },
        "status": { "enum": ["included", "not_included", "unavailable"] },
        "installs": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["js_runtime_deno", "yt_dlp"] } },
        "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
        "download_bytes": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "licences": { "type": "array", "maxItems": 4, "items": {
          "type": "object", "additionalProperties": false, "required": ["component", "licence"], "properties": {
            "component": { "enum": ["js_runtime_deno", "yt_dlp"] },
            "licence": { "type": "string", "minLength": 1, "maxLength": 256 }
          } } },
        "terms_notice": { "type": "string", "minLength": 1, "maxLength": 512 },
        "add_command": { "oneOf": [{ "type": "null" }, {
          "type": "object", "additionalProperties": false, "required": ["executable", "arguments"], "properties": {
            "executable": { "const": "vsift" },
            "arguments": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
          } }] },
        "actions": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/action" } },
        "next_step": { "$ref": "#/$defs/step" }
      }
    },
    "step": { "type": "string", "minLength": 1, "maxLength": 512 },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "state", "component", "version", "publisher", "source_url", "bytes", "sha256", "format", "archive_limits", "selected_files", "archive_links", "runtime_copies", "licence", "notice_url", "source_code_url", "trust_limit", "licence_scope", "destination", "permissions", "change", "required_authority", "files"],
      "properties": {
        "id": { "enum": ["install-ffmpeg_ffprobe", "install-whisper_cli", "install-whisper_model", "install-js_runtime_deno", "install-yt_dlp"] },
        "state": { "enum": ["pending", "current"] },
        "component": { "enum": ["ffmpeg_ffprobe", "whisper_cli", "whisper_model", "js_runtime_deno", "yt_dlp"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_url": { "type": "string", "pattern": "^https://", "maxLength": 512 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "format": { "enum": ["tar_xz", "tar_gz", "raw_file", "zip"] },
        "archive_limits": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["max_stream_bytes", "entries", "expanded_bytes"], "properties": {
              "max_stream_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
              "entries": { "type": "integer", "minimum": 1, "maximum": 4096 },
              "expanded_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
            } }
          ]
        },
        "selected_files": { "type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["archive_path", "runtime_name", "bytes", "sha256"], "properties": {
            "archive_path": { "type": "string", "minLength": 1, "maxLength": 256 },
            "runtime_name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        } },
        "archive_links": { "type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["archive_path", "target"], "properties": {
            "archive_path": { "type": "string", "minLength": 1, "maxLength": 256 },
            "target": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        } },
        "runtime_copies": { "type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "source_selected"], "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "source_selected": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        } },
        "licence": { "type": "string", "minLength": 1, "maxLength": 256 },
        "notice_url": { "type": "string", "pattern": "^https://", "maxLength": 512 },
        "source_code_url": { "type": "string", "pattern": "^https://", "maxLength": 512 },
        "trust_limit": { "type": "string", "minLength": 1, "maxLength": 512 },
        "licence_scope": { "const": "disclosure_not_legal_clearance" },
        "destination": { "const": "private_per_user_managed_runtime" },
        "permissions": { "const": "private_user_only" },
        "change": { "const": "planned_download_verify_extract_smoke_activate" },
        "required_authority": { "const": "user" },
        "files": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "bytes", "sha256", "mode"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "mode": { "enum": ["owner_executable", "owner_read_write"] }
            }
          }
        }
      }
    }
  }
}
