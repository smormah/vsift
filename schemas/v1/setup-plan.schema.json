{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsift.dev/schemas/v1/setup-plan.schema.json",
  "title": "VSift reviewed setup plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "operation_id", "status", "data", "warnings", "error", "coverage", "lifecycle"],
  "properties": {
    "schema_version": { "const": "1" },
    "command": { "const": "setup.plan" },
    "operation_id": { "type": "null" },
    "status": { "const": "complete" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "readiness", "verification_scope", "target", "local_asr_model", "managed_install", "catalogue_revision", "stop_new_plans_at", "plan_digest", "actions", "dependencies"],
      "properties": {
        "profile": { "enum": ["desktop", "worker"] },
        "readiness": { "enum": ["ready", "degraded", "blocked"] },
        "verification_scope": { "const": "executable_probe_and_reviewed_catalogue" },
        "target": { "enum": ["ubuntu_24_04_x86_64", "windows_x86_64", "macos_arm64", "unsupported"] },
        "local_asr_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "disposition", "required_authority", "next_step"],
          "properties": {
            "status": { "enum": ["missing", "configured_present_unverified"] },
            "disposition": { "enum": ["configured_model_probe_only", "managed_install", "manual_selection_required"] },
            "required_authority": { "enum": ["user", null] },
            "next_step": { "$ref": "#/$defs/step" }
          }
        },
        "managed_install": { "enum": ["catalogue_accepted_install_pending", "not_required", "unavailable_target", "unavailable_catalogue_expired", "unavailable_catalogue_invalid"] },
        "catalogue_revision": { "type": ["string", "null"], "maxLength": 128 },
        "stop_new_plans_at": { "type": ["string", "null"], "maxLength": 32 },
        "plan_digest": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
        "actions": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/action" } },
        "dependencies": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["dependency", "status", "disposition", "required_authority", "next_step"],
            "properties": {
              "dependency": { "enum": ["ffmpeg", "ffprobe", "whisper"] },
              "status": { "enum": ["available", "missing", "unhealthy", "timed_out"] },
              "disposition": { "enum": ["existing_executable_probe_only", "managed_install", "manual_selection_required"] },
              "required_authority": { "enum": ["user", null] },
              "next_step": { "$ref": "#/$defs/step" }
            }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "managed_install": { "enum": ["catalogue_accepted_install_pending", "not_required"] } } }, "then": { "properties": { "plan_digest": { "type": "string" }, "catalogue_revision": { "type": "string" }, "stop_new_plans_at": { "type": "string" } } } },
        { "if": { "properties": { "managed_install": { "enum": ["unavailable_target", "unavailable_catalogue_expired", "unavailable_catalogue_invalid"] } } }, "then": { "properties": { "plan_digest": { "type": "null" }, "actions": { "maxItems": 0 } } } }
      ]
    },
    "warnings": { "const": [] },
    "error": { "type": "null" },
    "coverage": { "type": "null" },
    "lifecycle": { "type": "null" }
  },
  "$defs": {
    "step": { "type": "string", "minLength": 1, "maxLength": 512 },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "component", "version", "publisher", "source_url", "bytes", "sha256", "format", "archive_limits", "selected_files", "archive_links", "runtime_copies", "licence", "notice_url", "source_code_url", "trust_limit", "licence_scope", "destination", "permissions", "change", "required_authority", "files"],
      "properties": {
        "id": { "enum": ["install-ffmpeg_ffprobe", "install-whisper_cli", "install-whisper_model"] },
        "component": { "enum": ["ffmpeg_ffprobe", "whisper_cli", "whisper_model"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_url": { "type": "string", "pattern": "^https://", "maxLength": 512 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "format": { "enum": ["tar_xz", "tar_gz", "raw_file"] },
        "archive_limits": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["max_stream_bytes", "entries", "expanded_bytes"], "properties": {
              "max_stream_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
              "entries": { "type": "integer", "minimum": 1, "maximum": 4096 },
              "expanded_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
            } }
          ]
        },
        "selected_files": { "type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["archive_path", "runtime_name", "bytes", "sha256"], "properties": {
            "archive_path": { "type": "string", "minLength": 1, "maxLength": 256 },
            "runtime_name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        } },
        "archive_links": { "type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["archive_path", "target"], "properties": {
            "archive_path": { "type": "string", "minLength": 1, "maxLength": 256 },
            "target": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        } },
        "runtime_copies": { "type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "source_selected"], "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "source_selected": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        } },
        "licence": { "type": "string", "minLength": 1, "maxLength": 256 },
        "notice_url": { "type": "string", "pattern": "^https://", "maxLength": 512 },
        "source_code_url": { "type": "string", "pattern": "^https://", "maxLength": 512 },
        "trust_limit": { "type": "string", "minLength": 1, "maxLength": 512 },
        "licence_scope": { "const": "disclosure_not_legal_clearance" },
        "destination": { "const": "private_per_user_managed_runtime" },
        "permissions": { "const": "private_user_only" },
        "change": { "const": "planned_download_verify_extract_smoke_activate" },
        "required_authority": { "const": "user" },
        "files": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "bytes", "sha256", "mode"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "mode": { "enum": ["owner_executable", "owner_read_write"] }
            }
          }
        }
      }
    }
  }
}
