{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsift.dev/schemas/v1/setup-check-response.schema.json",
  "title": "VSift setup.check response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "profile", "status", "dependencies"],
  "properties": {
    "schema_version": { "const": "1" },
    "command": { "const": "setup.check" },
    "profile": { "enum": ["desktop", "worker"] },
    "status": { "enum": ["ready", "degraded", "blocked"] },
    "verification_scope": { "const": "executable_probe_only" },
    "local_asr_model": { "const": "not_checked" },
    "dependencies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency", "capability", "status", "detail"],
        "properties": {
          "dependency": { "enum": ["ffmpeg", "ffprobe", "whisper"] },
          "capability": { "enum": ["media_processing", "transcription"] },
          "status": { "enum": ["available", "missing", "unhealthy", "timed_out"] },
          "lookup": { "enum": ["explicit_path", "filtered_path"] },
          "validation": { "enum": ["executable_probe_only", "not_validated"] },
          "remediation": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["reason", "managed_install", "required_authority", "next_step", "explicit_path_option"],
                "properties": {
                  "reason": { "enum": ["missing", "unhealthy", "timed_out"] },
                  "managed_install": { "const": "unavailable_unqualified" },
                  "required_authority": { "const": "user" },
                  "next_step": { "type": "string", "maxLength": 240 },
                  "explicit_path_option": { "enum": ["--ffmpeg", "--ffprobe", "--whisper"] }
                }
              }
            ]
          },
          "detail": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "maxLength": 240 }
            ]
          }
        }
      }
    }
  }
}
