{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsift.dev/schemas/v1/setup-check-response.schema.json",
  "title": "VSift setup.check response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "profile", "status", "dependencies"],
  "properties": {
    "schema_version": { "const": "1" },
    "command": { "const": "setup.check" },
    "profile": { "enum": ["desktop", "worker"] },
    "status": { "enum": ["ready", "degraded", "blocked"] },
    "verification_scope": { "const": "executable_probe_only" },
    "local_asr_model": {
      "description": "Kept constant for v1 compatibility; the local_asr object reports the model and its verification.",
      "const": "not_checked"
    },
    "local_asr": {
      "description": "Local speech recognition (added in P07 increment 3c). model: the registered model's identity against the reviewed pins. verification: whether whisper.cpp, the model and FFmpeg/FFprobe transcribed the reviewed speech clip built into VSift, from a recorded pass or run by this check within its own 60 s budget. Every detail field is present; those that do not apply to the status are null.",
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "verification"],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "profile"],
          "properties": {
            "status": { "enum": ["not_selected", "unreadable", "unrecognised", "known_pinned"] },
            "profile": { "enum": [null, "base", "base_q5_1"] }
          },
          "oneOf": [
            {
              "properties": {
                "status": { "const": "known_pinned" },
                "profile": { "enum": ["base", "base_q5_1"] }
              }
            },
            {
              "properties": {
                "status": { "enum": ["not_selected", "unreadable", "unrecognised"] },
                "profile": { "type": "null" }
              }
            }
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "not_run_reason", "check", "reason"],
          "properties": {
            "status": { "enum": ["verified", "failed", "not_run"] },
            "source": { "enum": [null, "recorded", "ran_now"] },
            "not_run_reason": {
              "enum": [null, "media_tools_unavailable", "whisper_unavailable", "model_not_selected", "model_not_pinned"]
            },
            "check": {
              "enum": [
                null, "preparation", "fixture_probe", "planning", "recognizer_identity",
                "audio_extraction", "recognition", "output_validation", "assembly", "transcript", "budget"
              ]
            },
            "reason": {
              "enum": [
                null, "fixture_integrity", "workspace", "fixture_media", "unexpected_transcript",
                "budget_exceeded", "invalid_range", "too_many_chunks", "model_changed",
                "model_unavailable", "unpinned_model", "cancelled", "deadline", "busy",
                "resource_limit", "audio_unavailable", "provider_failed", "unparseable_output",
                "malformed_output", "abnormal_termination", "io", "invalid_run"
              ]
            }
          },
          "oneOf": [
            {
              "properties": {
                "status": { "const": "verified" },
                "source": { "enum": ["recorded", "ran_now"] },
                "not_run_reason": { "type": "null" },
                "check": { "type": "null" },
                "reason": { "type": "null" }
              }
            },
            {
              "properties": {
                "status": { "const": "failed" },
                "source": { "type": "null" },
                "not_run_reason": { "type": "null" },
                "check": { "type": "string" },
                "reason": { "type": "string" }
              }
            },
            {
              "properties": {
                "status": { "const": "not_run" },
                "source": { "type": "null" },
                "not_run_reason": { "type": "string" },
                "check": { "type": "null" },
                "reason": { "type": "null" }
              }
            }
          ]
        }
      }
    },
    "managed_updates": {
      "description": "Added in 0.2.3, absent from earlier builds: each managed version this check opened (the managed tier of a tool no per-call or configured path selects, or the managed model when none is configured) that the current catalogue lists as superseded, in component order; empty when none. selected_version is what the managed store selects now, reviewed_version the version this release pins; reason security_fixes means the pin carries fixes for security defects of the selected version, maintenance any other reason. next_step says what to do: review setup plan and accept it with setup install, which installs and selects the pin. A version the catalogue does not list (a later release's, say) is never reported.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "selected_version", "reviewed_version", "reason", "next_step"],
        "properties": {
          "component": { "enum": ["ffmpeg_ffprobe", "whisper_cli", "whisper_model", "js_runtime_deno", "yt_dlp"] },
          "selected_version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "reviewed_version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "reason": { "enum": ["security_fixes", "maintenance"] },
          "next_step": { "type": "string", "maxLength": 240 }
        }
      }
    },
    "online_video": {
      "description": "Added in 0.3.0 (#409), absent from earlier builds: the optional online-video components, apart from the local-video status above, which they never change. installed when yt-dlp and its JavaScript runtime are installed, selected and verified (components gives their versions); not_installed when they are offered on this host and not both installed (add_command is the vsift command that plans them, on the desktop profile; ask the operator first); unavailable when no managed version is offered on this host.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "components", "next_step", "add_command"],
      "properties": {
        "status": { "enum": ["installed", "not_installed", "unavailable"] },
        "components": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["component", "version"],
            "properties": {
              "component": { "enum": ["js_runtime_deno", "yt_dlp"] },
              "version": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        },
        "next_step": { "type": "string", "minLength": 1, "maxLength": 512 },
        "add_command": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false, "required": ["executable", "arguments"],
              "properties": {
                "executable": { "const": "vsift" },
                "arguments": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
              }
            }
          ]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency", "capability", "status", "detail"],
        "properties": {
          "dependency": { "enum": ["ffmpeg", "ffprobe", "whisper"] },
          "capability": { "enum": ["media_processing", "transcription"] },
          "status": { "enum": ["available", "missing", "unhealthy", "timed_out"] },
          "lookup": { "enum": ["explicit_path", "configured_user_path", "managed_version", "filtered_path"] },
          "validation": { "enum": ["executable_probe_only", "not_validated"] },
          "remediation": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["reason", "managed_install", "required_authority", "next_step", "explicit_path_option"],
                "properties": {
                  "reason": { "enum": ["missing", "unhealthy", "timed_out"] },
                  "managed_install": { "enum": ["catalogue_accepted", "unavailable_target", "unavailable_catalogue_expired", "unavailable_catalogue_invalid"] },
                  "required_authority": { "const": "user" },
                  "next_step": { "type": "string", "maxLength": 240 },
                  "explicit_path_option": { "enum": ["--ffmpeg", "--ffprobe", "--whisper"] }
                }
              }
            ]
          },
          "detail": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "maxLength": 240 }
            ]
          }
        }
      }
    }
  }
}
